        "url": "https://api.activecampaign.com/api/3/contacts",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "email",
              "value": "={{$node[\"Webhook Trigger\"].json[\"customer_email\"]}}"
            }
          ]
        }
      },
      "id": "node_active_campaign",
      "name": "Add to Nurture Drip",
